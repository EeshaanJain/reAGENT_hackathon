# Per-method run output (component/predictions/logs/work), written by run_pipeline.py --
# regenerated by re-running the pipeline, not committed. Matches contract_gen/.gitignore and
# benchmark_adapt/.gitignore's own output/*/ convention.
#
# The tool scripts living directly in this directory (run_pipeline.py, pipeline_status.py) are
# real code, not output -- this only ignores subdirectories, never .py files at this level.
*/
!.gitignore
