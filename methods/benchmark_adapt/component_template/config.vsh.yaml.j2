__merge__: ../../api/comp_method.yaml

name: {{ method_id }}
label: {{ label | default(method_id) }}
summary: "{{ summary | default('Generated by benchmark_adapt Stage 4 -- see MODELSPEC.json for provenance.') }}"
description: |
  {{ description | default('Adapter synthesized from a model_contract.yaml handoff. Every scientific claim below is cited in MODELSPEC.json alongside this file; every divergence from the source paper''s stated protocol is recorded in DEVIATIONS.md.') }}

  Source: {{ repo_url }}{{ (' @ ' + commit) if commit else '' }}

links:
  repository: {{ repo_url }}

info:
  preferred_normalization: {{ preferred_normalization | default('unknown') }}

{% if arguments or requires_sc_counts %}
arguments:
{% for arg in arguments %}
  - type: {{ arg.arg_type }}
    name: {{ arg.name }}
    description: {{ arg.description | tojson }}
    default: {{ arg.value | tojson }}
{% endfor %}
{% if requires_sc_counts %}
  - type: file
    name: --sc_train
    required: false
    description: >-
      Raw single-cell counts (.h5ad). LOCAL, PROPOSED extension -- not a real wf_method.yaml
      argument in the upstream OP3 task today; this method's own entrypoint needs single-cell
      data (requires_sc_counts=true in the contract), which de_train/id_map cannot express. See
      DEVIATIONS.md for the citation trail and the proposed-not-merged status of this argument.
{% endif %}
{% endif %}

resources:
  - type: python_script
    path: script.py

engines:
  - type: docker
    # Reconstructed deterministically from the handed-off image's layers (C3) -- not hand-written.
    image: {{ docker_image }}
{% if dependencies or docker_setup %}
    setup:
{% if dependencies %}
      - type: python
        packages:
{% for dep in dependencies %}
          - "{{ dep.package }}{{ dep.value if dep.value and dep.value != 'unknown' else '' }}"
{% endfor %}
{% endif %}
{% if docker_setup %}
{{ docker_setup }}
{% endif %}
{% endif %}

runners:
  - type: executable
  - type: nextflow
    directives:
      label: [ {{ nextflow_labels | default('hightime, highmem, highcpu' + (', gpu' if gpu_required else '')) }} ]
