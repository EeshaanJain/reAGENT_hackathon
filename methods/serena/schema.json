{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Serena Repository Findings Schema",
  "description": "Machine-readable repository analysis findings from Serena MCP",
  "type": "object",
  "required": [
    "analysis_timestamp",
    "repo_path",
    "serena_status",
    "findings"
  ],
  "properties": {
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when analysis was performed"
    },
    "repo_path": {
      "type": "string",
      "description": "Relative path to the analyzed repository (e.g., 'work/repo')"
    },
    "serena_status": {
      "type": "string",
      "enum": ["success", "partial", "unavailable"],
      "description": "Whether Serena MCP was available and successful"
    },
    "serena_error": {
      "type": "string",
      "description": "Error message if serena_status is not 'success' (optional)"
    },
    "findings": {
      "type": "array",
      "description": "Array of discovered findings",
      "items": {
        "$ref": "#/definitions/Finding"
      }
    }
  },
  "definitions": {
    "Finding": {
      "type": "object",
      "required": [
        "type",
        "category",
        "file_path",
        "confidence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "public_api",
            "implementation",
            "data_loader",
            "preprocessing",
            "checkpoint",
            "example",
            "reference"
          ],
          "description": "Category of finding"
        },
        "category": {
          "type": "string",
          "description": "Subcategory or stage (e.g., 'training', 'inference', 'save/load')"
        },
        "symbol": {
          "type": "string",
          "description": "Python symbol name (function, class, method) if applicable"
        },
        "file_path": {
          "type": "string",
          "description": "Repository-relative file path (no absolute paths)"
        },
        "line_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer" },
          "description": "1-indexed [start_line, end_line] for the symbol or finding location"
        },
        "description": {
          "type": "string",
          "description": "Short human-readable description of the finding"
        },
        "confidence": {
          "type": "string",
          "enum": ["confirmed", "partial", "unknown"],
          "description": "Confidence level of the finding"
        },
        "evidence": {
          "type": "string",
          "description": "Citation/reference explaining how the finding was obtained"
        },
        "signature": {
          "type": "string",
          "description": "Function/method signature if available (optional)"
        },
        "body_snippet": {
          "type": "string",
          "description": "First few lines of code body if available (optional)"
        },
        "related_symbols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other symbols referenced by this one (optional)"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "External dependencies or module imports (optional)"
        },
        "notes": {
          "type": "string",
          "description": "Additional context or caveats (optional)"
        }
      }
    }
  }
}
